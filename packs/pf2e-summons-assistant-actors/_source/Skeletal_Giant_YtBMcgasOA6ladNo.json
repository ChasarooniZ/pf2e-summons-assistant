    {
      "type": "action",
      "name": "Earthshaking Entrance (Arrive)",
      "system": {
        "actionType": {
          "value": "free"
        },
        "description": {
          "value": "<p>The giant lands on the ground with a resounding crash, shaking the earth with its weight. Creatures on the ground in a @Template[type:emanation|distance:20] must attempt a @Check[fortitude|dc:resolve(@actor.system.resources.dc.value)] save.</p><hr><p><strong>Critical Success</strong> The creature is unaffected.</p><p><strong>Success</strong> The creature is knocked @UUID[Compendium.pf2e.conditionitems.Item.j91X7x0XSomq8d60]{Prone}.</p><p><strong>Failure</strong> The creature is knocked prone and @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 1} for 1 round.</p><p><strong>Critical Failure</strong> The creature is knocked prone and @UUID[Compendium.pf2e.conditionitems.Item.i3OJZU2nk64Df3xm]{Clumsy 2} for 1 round.</p>",
          "gm": ""
        },
